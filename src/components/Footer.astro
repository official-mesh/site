---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
const year = new Date().getFullYear();
---

<footer class="mt-32 mb-12 border-t border-line pt-8">
  <Container>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-muted">
      <div class="font-mono">
        © {year} · {SITE.NAME}
      </div>
      <div class="flex gap-5 font-mono text-xs uppercase tracking-[0.18em]">
        <a href={`https://github.com/${SITE.GH_ORG}`} class="linky" rel="noopener">github</a>
        <a href={`https://github.com/${SITE.GH_ORG}/site`} class="linky" rel="noopener">site source</a>
      </div>
    </div>
  </Container>
</footer>
